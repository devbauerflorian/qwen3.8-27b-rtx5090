# Copy to .env and fill in. Both `docker compose` and `setup.sh` read this file.

# Bearer key for the vLLM OpenAI-compatible API (Authorization: Bearer <key>).
# Leave empty to run without authentication (local networks only!).
VLLM_API_KEY=

# Model selection (all optional — unset keys keep the defaults for the stock
# Qwen3.8-27B NVFP4 model). Uncomment and adjust to switch models.
#MODEL_REPO=gittensor-model-hub/Qwen3.8-27B-NVFP4-RTX5090
#MODEL_SUBDIR=qwen3.8-27b-nvfp4
#SERVED_MODEL_NAME=qwen3.8-27b
#CONTAINER_NAME=vllm

# Model weights are pinned to a known-good Hugging Face revision (the default
# in setup.sh). Set to another revision sha to fetch that state, or to an
# empty string to always download the latest weights.
#MODEL_REVISION=69274a0d8dff5dd35bcee8290612f71e03b6e981

# --- Monitoring (caddy / prometheus / grafana services in docker-compose.yml) ---

# Login for the auto-provisioned Grafana vLLM dashboard (http://<host>:3000):
#GRAFANA_ADMIN_USER=admin
#GRAFANA_ADMIN_PASSWORD=choose-a-long-random-string
# (applied only on first Grafana DB init; rotate later via the Grafana UI)

# HTTP Basic auth for the caddy gateway (port 8020, routes /v1/*, /metrics, /dcgm/metrics).
# If METRICS_HASH is missing/empty, caddy will not start (fail-closed).
# METRICS_HASH must be the bcrypt hash of METRICS_PASSWORD:
#   python3 -c "import bcrypt;print(bcrypt.hashpw(input().encode(),bcrypt.gensalt(12)).decode()).replace('$2b$','$2a$')"
#   (caddy/Go expects the $2a$ prefix, hence the replace(); the one-liner
#   needs Python's `bcrypt` module, e.g. `pip install bcrypt`)
#METRICS_USER=metrics
#METRICS_PASSWORD=
#METRICS_HASH=
