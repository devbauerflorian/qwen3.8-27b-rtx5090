# Copy to .env and fill in. Both `docker compose` and `setup.sh` read this file.

# Bearer key for the vLLM OpenAI-compatible API (Authorization: Bearer <key>).
# Leave empty to run without authentication (local networks only!).
VLLM_API_KEY=

# Model selection (all optional — unset keys keep the defaults for the stock
# Qwen3.8-27B NVFP4 model). Uncomment and adjust to switch models.
#MODEL_REPO=gittensor-model-hub/Qwen3.8-27B-NVFP4-RTX5090
#MODEL_SUBDIR=qwen3.8-27b-nvfp4
#SERVED_MODEL_NAME=qwen3.8-27b
#CONTAINER_NAME=vllm

# Model weights are pinned to a known-good Hugging Face revision (the default
# in setup.sh). Set to another revision sha to fetch that state, or to an
# empty string to always download the latest weights.
#MODEL_REVISION=69274a0d8dff5dd35bcee8290612f71e03b6e981
